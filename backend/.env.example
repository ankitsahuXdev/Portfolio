# Copy this file to ".env" and fill in your own values.
# ".env" is where your real secrets live — never share it or upload it anywhere public.

PORT=5000

# Jab frontend ko kisi doosri jagah (Netlify/GitHub Pages) host karein, yahan
# uska exact URL daal dena (e.g. https://ankitsahu.netlify.app). Testing ke
# liye "*" theek hai.
CORS_ORIGIN=*

# ---------------------------------------------------------
# STORAGE — where contact messages get saved
# ---------------------------------------------------------
# "json"  -> zero setup, saves to backend/data/messages.json (default)
# "mysql" -> saves to a MySQL database (needs MySQL running, see below)
DB_TYPE=json

# Only needed if DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234
DB_NAME=portfolio

# ---------------------------------------------------------
# EMAIL NOTIFICATION — get an email the moment someone messages you
# ---------------------------------------------------------
# Use a Gmail "App Password", not your normal Gmail password.
# README.md mein pura tarika diya hai ki App Password kaise banayein.
EMAIL_USER=
EMAIL_PASS=
# Optional: agar khali chhoda to EMAIL_USER wale inbox mein hi aayega
NOTIFY_EMAIL=

# ---------------------------------------------------------
# TELEGRAM NOTIFICATION (optional) — instant push on your phone
# ---------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------
# ADMIN PANEL — set any password-like string, used to view messages at /admin
# ---------------------------------------------------------
ADMIN_KEY=Ankitsahu1122
